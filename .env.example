# Copy to .env and adjust. Nested keys use a double-underscore delimiter.

APP__ENV=local
APP__DEBUG=true
APP__AUTH_DISABLED=true

DB__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic
DB__ECHO=false

REDIS__URL=redis://localhost:6379/0
REDIS__SESSION_TTL_S=3600

LLM__PROVIDER=anthropic
LLM__ANTHROPIC_API_KEY=
LLM__FAST_MODEL=claude-haiku-4-5-20251001
LLM__BALANCED_MODEL=claude-sonnet-5
LLM__DEEP_MODEL=claude-opus-5
LLM__MAX_TOKENS=2048
